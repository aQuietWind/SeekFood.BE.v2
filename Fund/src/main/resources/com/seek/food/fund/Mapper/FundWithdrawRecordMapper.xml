<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seek.food.fund.Mapper.FundWithdrawRecordMapper">

    <!-- 全局统一字段映射 -->
    <resultMap id="FundWithdrawRecordResultMap" type="com.seek.food.dto.Fund.FundWithdrawRecordDTO">
    </resultMap>



    <insert id="insertWithdrawRecord">
        insert into fund_withdraw_record (record_id,account_id,withdraw_description,withdraw_amount)
        values(#{recordId},#{accountId},#{withdrawDescription},#{withdrawAmount})
    </insert>

    <select id="getSimple" resultMap="FundWithdrawRecordResultMap">
        select
            record_id,
            account_id,
            withdraw_amount,
            create_time
        from fund_withdraw_record where account_id=#{accountId} order by record_id limit #{start},#{need}
    </select>

    <select id="getDetail" resultMap="FundWithdrawRecordResultMap">
        select
            record_id,
            account_id,
            withdraw_description,
            withdraw_amount,
            create_time
        from fund_withdraw_record where record_id=#{recordId} and account_id=#{accountId}
    </select>
</mapper>