<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.seek.food.fund.Mapper.FundOrderRefundRecordMapper">

    <!-- 全局统一字段映射 -->
    <resultMap id="FundOrderRefundRecordResultMap" type="com.seek.food.dto.Fund.FundOrderRefundRecordDTO">
    </resultMap>

    <select id="getSimple" resultMap="FundOrderRefundRecordResultMap">
        select
            record_id,
            account_id,
            order_id,
            refund_cost,
            create_time
        from fund_order_refund_record where account_id=#{accountId} order by record_id limit #{start},#{need}
    </select>

</mapper>